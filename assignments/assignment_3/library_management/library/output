package library.main;

import library.model.Book;
import library.model.DigitalResource;
import library.model.Journal;
import library.model.LibraryResource;
import library.model.Printable;
import library.util.InputValidator;

public class Main {
    public static void main(String[] args) {
        InputValidator validator = new InputValidator();
        LibraryResource[] resources = new LibraryResource[5];

        resources[0] = new Book(101, "Java Programming", "John Doe");
        resources[1] = new DigitalResource(102, "Design Patterns", "Jane Smith");
        resources[2] = new Book(103, "Data Structures", "Alice Johnson");
        resources[3] = new DigitalResource(104, "Database Systems", "Bob Wilson");
        resources[4] = new Journal(105, "Computer Science Review", "Charlie Brown");

        System.out.println("========== LIBRARY RESOURCE DETAILS ==========");
        double totalFine = 0;

        for (LibraryResource resource : resources) {
            resource.printDetails();
            System.out.println("Overdue Fine  : Rs. " + resource.calculateFine(3));
            System.out.println("----------------------------------------");
            totalFine += resource.calculateFine(3);
        }

        System.out.println("========== TOTAL STATISTICS ==========");
        System.out.println("Total Resources Created: " + LibraryResource.total_resources());
        System.out.println("Total Fine for 3 days overdue: Rs. " + totalFine);
        System.out.println("Library Name: " + LibraryResource.getLibraryName());
    }
}

